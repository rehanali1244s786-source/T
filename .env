# Copy this file to .env and fill in your values (never commit a real token)
BOT_TOKEN=9055589116:AAHLesiRJN9ANzGS0sQbtukKm_PwUi4FI6w
# Your Telegram user id(s), comma separated (send /id to the bot to get it)
ADMIN_IDS=8322654093
# Path to persistent JSON database (Railway Volume mounted at /data uses /data/musicbot_data.json)
DATA_FILE=/data/musicbot_data.json
# Bot version shown on the welcome & info tables
BOT_VERSION=3.0
# Banner image URL shown on /start and /menu
MENU_BANNER_URL=https://i.postimg.cc/CMQZFb9S/87e5be23babb05a5a48bd8635b19f9ea.jpg
# Optional: path to cookies.txt if YouTube shows "sign in / bot" errors (or set COOKIES_B64)
COOKIES_FILE=cookies.txt
# Max simultaneous downloads (default 6, lower on small servers)
MAX_PARALLEL_DOWNLOADS=6
# Song recognition (/find, voice notes): get a free token at https://dashboard.audd.io
AUDD_TOKEN=6d27f5b251097fc9410ff142b030280d
# Recognitions per user per day (admins unlimited)
RECOGNIZE_DAILY_LIMIT=5
# Recognitions per day for premium users
PREMIUM_RECOG_LIMIT=50
# Referral: +REF_BONUS recognitions/day per invited friend, up to REF_MAX_BONUS
REF_BONUS=1
REF_MAX_BONUS=10
# Followed artists: how often (hours) new releases are checked and follow limits
RELEASE_CHECK_HOURS=6
FOLLOW_LIMIT_FREE=5
FOLLOW_LIMIT_PREMIUM=25
# Optional: BPM works automatically via Deezer; a GetSongBPM key adds musical key too
GETSONGBPM_KEY=
# Contact info sent to MusicBrainz in the User-Agent
MB_USER_AGENT=MusicBot/3.0 ( https://t.me/Dockworldwide )
# 1 = every group admin can set a footer with /brand (0 = premium perk)
BRANDING_FREE=0
